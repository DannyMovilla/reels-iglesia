exports[`el CSS de los estilos de antes no cambia > impacto 1`] = `
".sub.impacto { font: 900 109px/1 Montserrat, sans-serif; letter-spacing: 0.03em; height: 112px; }
.sub.impacto .w { position: absolute; left: 0; right: 0; opacity: 0; -webkit-text-stroke: 11px #0b0b0b; paint-order: stroke fill; text-shadow: 0 8px 22px rgba(0,0,0,.5); }"
`;

exports[`el CSS de los estilos de antes no cambia > karaoke 1`] = `
".sub.karaoke { font: 800 57px/1.25 Figtree, sans-serif; }
.sub.karaoke .pildora { display: inline-block; max-width: 100%; padding: 16px 44px 18px; border-radius: 22px; background: #eceaec; box-shadow: 0 6px 22px rgba(0,0,0,.28); }
.sub.karaoke .w { color: #a6a6a6; margin: 0 0.12em; }"
`;

exports[`el CSS de los estilos de antes no cambia > neon 1`] = `
".sub.neon { font: 800 70px/1.15 Montserrat, sans-serif; text-shadow: 0 0 10px rgba(255,255,255,.55), 0 0 24px rgba(255,255,255,.25), 0 4px 14px rgba(0,0,0,.6); }
.sub.neon .clave { font-size: 1.2em; text-shadow: 0 0 12px var(--marca), 0 0 30px var(--marca), 0 4px 14px rgba(0,0,0,.6); }"
`;

exports[`el CSS de los estilos de antes no cambia > resaltado 1`] = `
".sub.resaltado { font: 800 70px/1.35 Montserrat, sans-serif; letter-spacing: 0.02em; }
.sub.resaltado .w { position: relative; padding: 4px 12px 6px; text-shadow: 0 4px 14px rgba(0,0,0,.55); }
.sub.resaltado .w > span { position: relative; z-index: 1; }
.sub.resaltado .fondo { position: absolute; inset: 0; z-index: 0; background: var(--marca); border-radius: 10px; box-shadow: 0 12px 30px rgba(0,0,0,.32); opacity: 0; transform: scaleX(0); transform-origin: 0% 50%; }"
`;

